BOT_TOKEN=your-bot-token-here
# Comma-separated user IDs with admin rights (cookie upload, admin commands)
BOT_ADMIN_IDS=
# Comma-separated user IDs merged with allowed-users.json
ALLOWED_USER_IDS=
# Comma-separated group chat IDs where the bot answers
ALLOWED_GROUP_IDS=
DOWNLOAD_DIR=/tmp/bot-downloads
MAX_FILE_SIZE=50
MAX_CONCURRENT_DOWNLOADS=3

# Logging
# MODE=development|dev → *.dev.jsonl files; MODE=production|prod → production files
MODE=dev
# LOG_OUTPUT=console|stdout, file, or both (default)
LOG_OUTPUT=both
LOG_DIR=logs
LOG_LEVEL=DEBUG

# Media cache directory (docker-compose.yml overrides this to /usr/src/app/data)
CACHE_DIR=data

# Enable Guest Mode (Bot API 10.0) - allows bot invocation in any chat via @mention
GUEST_MODE_ENABLED=false
# Private channel ID for guest mode file storage (bot must be admin)
# Create a private channel, add the bot as admin, then set the ID here
STORAGE_CHANNEL_ID=

# Instagram cookies (Netscape format, browser export or bot upload)
IG_COOKIES_PATH=ig-cookies.txt

# TikTok cookies (Netscape format, exported from browser)
TIKTOK_COOKIES_PATH=tiktok-cookies.txt

# YouTube cookies (Netscape format)
COOKIES_DIR=cookies
YT_COOKIES_PATH=yt-cookies.txt
