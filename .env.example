BOT_TOKEN=your-bot-token-here
BOT_ADMIN_IDS=
ALLOWED_USER_IDS=
DOWNLOAD_DIR=/tmp/bot-downloads
MAX_FILE_SIZE=50
MAX_CONCURRENT_DOWNLOADS=3
MODE=dev
LOG_LEVEL=DEBUG

# Enable Guest Mode (Bot API 10.0) - allows bot invocation in any chat via @mention
GUEST_MODE_ENABLED=false
# Private channel ID for guest mode file storage (bot must be admin)
# Create a private channel, add the bot as admin, then set the ID here
STORAGE_CHANNEL_ID=

# Instagram cookie refresh (instagrapi login)
IG_USERNAME=
IG_PASSWORD=
IG_COOKIES_PATH=ig-cookies.txt
IG_SESSION_PATH=ig-session.json

# TikTok cookies (Netscape format, exported from browser)
TIKTOK_COOKIES_PATH=tiktok-cookies.txt
